{
  "SolicitorsCom": {
    "BaseUrl": "https://www.solicitors.com",
    "ConveyancingPath": "/conveyancing.html",
    "AutocompletePath": "/scripts/locations.asp",
    "PrepareSearchPath": "/prepare-search.asp",
    "TimeoutSeconds": 30
  },
  "SolicitorSearch": {
    "DefaultLocations": [
      "London",
      "Birmingham",
      "Leeds",
      "Manchester",
      "Sheffield",
      "Bradford",
      "Liverpool",
      "Bristol"
    ],
    "MaxLocations": 10,
    "DefaultPageSize": 10,
    "ProfileFetchConcurrency": 4
  },
  "SolicitorSearchCache": {
    "Enabled": true,
    "ListTimeToLiveHours": 24,
    "ProfileTimeToLiveHours": 24,
    "MaxEntries": 1000
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "*"
}
